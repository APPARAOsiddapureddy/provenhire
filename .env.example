VITE_LOCAL_RESUME_PARSER_URL="http://127.0.0.1:8000"

# ── Antigravity AI Interview Engine ────────────────────────────────────────────
# URL of the Antigravity Next.js frontend service.
# Dev default (when running `next dev` inside /antigravity): http://localhost:3000
# Production: the Vercel deployment URL of the antigravity project.
# VITE_ANTIGRAVITY_ORIGIN=http://localhost:3000

# Set to "true" to route the expert_interview verification stage through Antigravity
# instead of the built-in ExpertInterviewStage.  Default: false (built-in stage).
# VITE_USE_ANTIGRAVITY=true

# Google Search Console — injected into index.html at build time (meta google-site-verification).
# VITE_GOOGLE_SITE_VERIFICATION=your_verification_string

# Firebase (Google Sign-In) - from Firebase Console > Project Settings
# For production: copy these to Vercel Environment Variables and add your Vercel domain to Firebase Authorized domains.
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=provenhire-c153e.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abc123
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional: "true" = always use full-page Google redirect (good for COOP-strict browsers). "false" = always use popup (dev UX).
# Default: redirect in production, popup in development.
# VITE_GOOGLE_USE_REDIRECT=true
