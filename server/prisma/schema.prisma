generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  jobseeker
  recruiter
  admin
  expert_interviewer
}

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  passwordHash  String   // Placeholder hash for OAuth users (never used for login)
  role          UserRole @default(jobseeker)
  emailVerified Boolean  @default(false)
  authProvider  String?  @default("EMAIL") // EMAIL | GOOGLE
  googleUid     String?  @unique
  profileImage  String?
  createdAt     DateTime @default(now())

  jobSeekerProfile JobSeekerProfile?
  recruiterProfile RecruiterProfile?
  interviews       Interview[]
  resumeAnalyses   ResumeAnalysis[]
  jobApplications  JobApplication[] @relation("JobApplicationsByUser")
  savedJobs        SavedJob[]
  verificationStages VerificationStage[]
  aptitudeResults    AptitudeTestResult[]
  aptitudeSessions   AptitudeSession[]
  dsaResults          DsaRoundResult[]
  notifications       Notification[]
  appeals             Appeal[]
  humanInterviewSessions HumanInterviewSession[]
  humanInterviewAttempts HumanInterviewAttempt[]
  humanInterviewBookings HumanInterviewBooking[]
  adminReviewQueuesCandidate AdminReviewQueue[] @relation("AdminReviewCandidate")
  adminReviewQueuesReviewer  AdminReviewQueue[] @relation("AdminReviewReviewer")
  bookedSlots         InterviewerSlot[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  interviewerProfile  Interviewer?
  skillVerifications  CandidateSkillVerification[]
  preferences         UserPreferences?
}

model JobSeekerProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  fullName             String?
  email                String?
  currentRole          String?
  experienceYears      Int?
  resumeUrl            String?
  about                String?
  phone                String?
  location             String?
  college              String?
  graduationYear       String?
  verificationStatus   String?
  skills               Json?
  education            Json?
  workExperience       Json?
  roleType             String?  @default("technical")
  targetJobTitle       String?
  noticePeriod         String?  // e.g. "15 days", "1 month", "Immediate"
  currentSalary        String?  // e.g. "10 LPA", "15-20 L"
  expectedSalary       String?  // e.g. "20 LPA", "25-30 L"
  // Settings: Career preferences & portfolio
  githubUrl            String?
  linkedInUrl          String?
  portfolioUrl         String?
  preferredTechStack   Json?    // string[]
  experienceLevel      String?  // Entry Level | Mid Level | Senior Level
  preferredLocations   Json?    // string[]
  workModePreference   String?  // Remote | Hybrid | Onsite
  /// Set when the user fails 3 consecutive aptitude attempts; cleared implicitly once date passes (checked at request time).
  aptitudeLockedUntil  DateTime?
  /// Latest non-technical verification assignment (prompt + submission); used by GET /assignment/current.
  nonTechAssignmentPrompt   String?   @db.Text
  nonTechAssignmentResponse   String?   @db.Text
  /// Window for assignment freshness (e.g. set to submittedAt + 36h on each submit).
  nonTechAssignmentExpiresAt  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum RecruiterVerificationStatus {
  pending
  verified
  rejected
}

model RecruiterProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  companyName            String?
  companySize            String?
  designation            String?
  phone                  String?
  companyWebsite         String?
  industry               String?
  hiringFor              String?
  onboardingCompleted    Boolean  @default(false)
  // Recruiter verification (required for job posting)
  fullName               String?
  workEmail              String?
  linkedInProfile        String?
  companyLinkedin        String?
  verificationDocumentUrl String?
  verificationStatus     RecruiterVerificationStatus @default(pending)
  emailDomainVerified    Boolean  @default(false)
  verificationRejectedReason String?  // Admin message when rejected
  // Settings: Company profile
  companyLogo            String?
  headquarters           String?
  companyDescription     String?
  // Settings: Hiring preferences
  preferredRoles         Json?    // string[]
  preferredExperienceMin  Int?
  preferredExperienceMax  Int?
  preferredSkills        Json?    // string[]
  minimumCertificationLevel Int?  @default(1) // 0-3: Cognitive, Skill Passport, Elite
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  jobs Job[]
}

model Job {
  id             String   @id @default(uuid())
  title          String
  company        String
  location       String?
  // "draft" | "published"
  // Legacy values: "active" treated as "published"; "closed" treated as "draft".
  status         String   @default("published")
  salaryRange    String?
  jobType        String?
  description    String?
  jobTrack       String?  @default("tech")
  assignment     String?  // Non-technical: AI-generated assignment for applicants
  roleCategory   String?  // e.g. Marketing, Sales, HR
  companyContext String?  // Brief company description for assignment context
  minimumCertificationLevel Int @default(1)
  createdAt      DateTime @default(now())
  postedById     String?

  postedBy RecruiterProfile? @relation(fields: [postedById], references: [id])
  applications JobApplication[]
  savedBy       SavedJob[]
}

model JobApplication {
  id                 String   @id @default(uuid())
  jobId              String
  jobSeekerId        String
  status             String   @default("applied")
  appliedAt          DateTime @default(now())
  resumeUrl          String?
  assignmentResponse String?  // Applicant's submission for non-technical job assignment

  job       Job  @relation(fields: [jobId], references: [id])
  jobSeeker User @relation("JobApplicationsByUser", fields: [jobSeekerId], references: [id])
}

model SavedJob {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  savedAt   DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, jobId])
}

model VerificationStage {
  id        String   @id @default(uuid())
  userId    String
  stageName String
  status    String
  score     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, stageName])
}

enum SkillVerificationStatus {
  ACTIVE
  EXPIRED
  PENDING
  FAILED
}

enum SkillType {
  APTITUDE
  LIVE_CODING
  INTERVIEW
}

/// Skill validity and expiry - each verification has completed_at + expires_at.
/// Used for "Skill Freshness Verification System" - candidates must re-attempt after expiry.
model CandidateSkillVerification {
  id          String                 @id @default(uuid())
  userId      String
  skillType   SkillType
  status      SkillVerificationStatus
  score       Int?
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillType])
  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

model AptitudeTestResult {
  id         String   @id @default(uuid())
  userId     String
  score      Int?
  answers    Json?
  completedAt DateTime @default(now())
  invalidated Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

/// Stores answer key + marks key for scoring aptitude submissions. Persisted so retries work across server restarts/instances.
model AptitudeSession {
  id        String   @id @default(uuid())
  userId    String   @unique
  questions Json     @default(dbgenerated("'[]'::jsonb")) // AptitudeQuestionForClient[] (persisted to allow resume with same question set)
  answerKey Json     // Record<string, string>
  marksKey  Json     // Record<string, number>
  draft     Json?    // { answers?: Record<string,string>, reviewed?: string[], visited?: string[], currentIndex?: number, secondsRemaining?: number }
  /// Server time when this question set was issued (enforced on submit).
  testStartedAt DateTime?
  /// aptitude_mixed | cs_fundamentals_medium | cs_fundamentals_advanced
  questionSet String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DsaRoundResult {
  id         String   @id @default(uuid())
  userId     String
  score      Int?
  answers    Json?
  completedAt DateTime @default(now())
  invalidated Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

model DsaQuestion {
  id          String   @id @default(cuid())
  title       String
  description String
  difficulty  String
  examples    Json
  constraints String[]
  starterCode Json // { javascript: string, python: string, ... }
  createdAt   DateTime @default(now())

  testCases DsaTestCase[]
}

model DsaTestCase {
  id         String   @id @default(cuid())
  questionId String
  input      String
  expected   String
  isHidden   Boolean  @default(false)
  expectedType String @default("exact") // "exact" | "numeric" | "array" | "set"
  timeoutMs    Int? // Per-test timeout override in ms; null => use global default

  question DsaQuestion @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

model DsaSubmission {
  id          String   @id @default(cuid())
  userId      String
  questionId String
  language    String
  code        String   @db.Text
  passedCount Int
  totalCount  Int
  isOfficial  Boolean  @default(false)
  results     Json
  submittedAt DateTime @default(now())

  @@index([userId, questionId])
  @@index([userId, isOfficial])
}

model Interview {
  id            String   @id @default(uuid())
  userId        String
  jobRole       String
  /// junior | mid | senior — AI interview calibration + DB question selection
  experienceLevel String?
  totalScore    Int?
  badgeLevel    String?
  finalVerdict  String?
  scoreBreakdown Json?
  /// in_progress | completed | pending_review
  status        String   @default("in_progress")
  questionIndex Int      @default(0)
  questionPlan  Json?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  reviewFlag          Boolean   @default(false)
  reviewReason        String?
  /// Count of proctoring alert rows for this interview session (not a 0–100 risk score).
  riskScore           Float?
  /// Total proctoring alert rows (denormalized; optional).
  proctoringEventCount Int?
  integrityFlag       String?
  reviewRequestedAt   DateTime?
  reviewRequestReason String?   @db.VarChar(500)
  reviewOutcome       String?
  reviewOutcomeNote   String?

  user              User                    @relation(fields: [userId], references: [id])
  messages          InterviewMessage[]
  questionResults   InterviewQuestionResult[]
  proctoringReviews ProctoringReviewLog[]
  adminReviewQueue  AdminReviewQueue?
}

/// After AI interview submission: admin approves/rejects before human expert stage + payment gate.
model AdminReviewQueue {
  id            String    @id @default(uuid())
  candidateId   String
  aiInterviewId String    @unique
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  reviewedAt  DateTime?
  reviewerId  String?

  candidate   User      @relation("AdminReviewCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  aiInterview Interview @relation(fields: [aiInterviewId], references: [id], onDelete: Cascade)
  reviewer    User?     @relation("AdminReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  attempts    HumanInterviewAttempt[]

  @@index([candidateId])
  @@index([status, createdAt])
}

/// One row per admin approval cycle: tracks payment (₹399 retries) and links to booking.
model HumanInterviewAttempt {
  id                  String    @id @default(uuid())
  candidateId         String
  adminReviewQueueId  String
  attemptNumber       Int
  paymentStatus       String    @default("pending")
  slotId              String?
  amountPaise         Int?
  razorpayOrderId     String?   @unique
  razorpayPaymentId   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  candidate User             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  queue     AdminReviewQueue @relation(fields: [adminReviewQueueId], references: [id], onDelete: Cascade)
  slot      InterviewerSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  session   HumanInterviewSession?
  bookings  HumanInterviewBooking[]

  @@index([candidateId])
  @@index([adminReviewQueueId])
}

model InterviewMessage {
  id          String   @id @default(uuid())
  interviewId String
  sender      String
  message     String
  questionType String?
  isFollowup  Boolean @default(false)
  audioUrl    String?  // Stored audio for user answers (no video storage)
  createdAt   DateTime @default(now())
  /// 0-based index of the question this user message answers (Pro Upgrade)
  questionIndex           Int?
  transcriptionConfidence Float?
  inputMode               String  @default("typed") // voice | typed
  rawTranscript           String?  @db.Text
  answerLengthChars       Int?
  pasteCount              Int     @default(0)
  timeToSubmitSeconds     Int?
  flagAntiGaming          Boolean @default(false)
  flagReason              String?

  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionResult  InterviewQuestionResult?
}

/// Admin-managed AI interview questions (optional; static fallback when QUESTION_BANK_SOURCE=static)
model InterviewQuestionBank {
  id              String   @id @default(uuid())
  role            String
  experienceLevel String // junior | mid | senior
  type            String // conceptual | scenario | problem_solving | behavioral
  prompt          String   @db.Text
  keyPoints       Json // string[]
  difficulty      Int      @default(2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  tags            String[] @default([])

  results InterviewQuestionResult[]

  @@index([role, experienceLevel, type, isActive])
}

model InterviewQuestionResult {
  id                 String   @id @default(uuid())
  interviewId        String
  messageId          String   @unique
  questionBankId     String?
  questionIndex      Int
  questionType       String
  scoreConceptual    Float?
  scoreReasoning     Float?
  scoreCommunication Float?
  rationale          String?  @db.Text
  keyPointsHit       String[] @default([])
  keyPointsMissed    String[] @default([])
  flagAntiGaming     Boolean  @default(false)
  flagReason         String?

  interview    Interview             @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  message      InterviewMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  questionBank InterviewQuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
}

model ProctoringReviewLog {
  id          String   @id @default(uuid())
  interviewId String
  adminId     String?
  action      String
  note        String   @db.Text
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model ResumeAnalysis {
  id        String   @id @default(uuid())
  userId    String
  score     Int?
  feedback  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  read       Boolean  @default(false)
  targetRole String?  // jobseeker | recruiter | expert_interviewer | all (for broadcast tracking)
  sentBy     String?  // admin userId who sent
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model JobAlertSubscription {
  id                 String   @id @default(uuid())
  userId             String   @unique
  email              String
  skills             Json?
  isActive           Boolean  @default(true)
  frequency          String   @default("daily")
  minMatchPercentage Int      @default(50)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Appeal {
  id        String   @id @default(uuid())
  userId    String
  stage     String
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model InterviewerApplication {
  id              String   @id @default(uuid())
  name            String
  email           String
  experienceYears Int?
  track           String   @default("technical")
  domains         Json?
  linkedIn        String?
  whyJoin         String?
  phone           String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?
}

model Interviewer {
  id                     String   @id @default(uuid())
  userId                 String?  @unique
  name                   String?
  domain                 String?
  track                  String?  @default("technical")
  domains                Json?
  experienceYears        Int?
  phone                  String?
  status                 String   @default("active")
  // Settings: Interviewer profile
  profileImage           String?
  currentCompany         String?
  jobTitle               String?
  linkedInUrl            String?
  // Settings: Expertise & topics
  expertiseAreas         Json?    // string[] e.g. Backend, Frontend, System Design
  preferredInterviewTopics Json?  // string[] e.g. DSA, System design
  // Settings: Availability (JSON: { Mon: [{ start, end }], ... })
  availabilitySchedule   Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user    User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  slots   InterviewerSlot[]
  sessions HumanInterviewSession[]
}

model InterviewerInvite {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model InterviewerSlot {
  id            String   @id @default(uuid())
  interviewerId String
  startsAt      DateTime
  endsAt        DateTime?
  status        String   @default("available")
  bookedUserId  String?

  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  bookedUser  User?      @relation(fields: [bookedUserId], references: [id])
  session     HumanInterviewSession?
  attemptBookings HumanInterviewAttempt[]
  humanInterviewBookings HumanInterviewBooking[]
}

model HumanInterviewSession {
  id                   String    @id @default(uuid())
  userId               String
  interviewerId        String
  slotId               String?   @unique
  scheduledAt          DateTime?
  completedAt          DateTime?
  status               String    @default("scheduled")
  meetingLink          String?
  verificationTier     String?
  evaluationScores     Json?
  evaluationNotes      String?
  evaluationPass       Boolean?
  evaluationSubmittedAt DateTime?
  attemptNumber        Int       @default(1)
  paymentStatus        String    @default("waived")
  humanInterviewAttemptId String? @unique
  humanInterviewAttempt HumanInterviewAttempt? @relation(fields: [humanInterviewAttemptId], references: [id], onDelete: SetNull)

  user        User         @relation(fields: [userId], references: [id])
  interviewer Interviewer  @relation(fields: [interviewerId], references: [id])
  slot        InterviewerSlot? @relation(fields: [slotId], references: [id])
  bookings    HumanInterviewBooking[]
}

/// Canonical slot booking record for the Human Expert Interview.
/// Matches the PRD table `human_interview_bookings`.
model HumanInterviewBooking {
  bookingId               String   @id @default(uuid()) @map("booking_id")
  candidateId             String   @map("candidate_id")
  slotId                  String   @map("slot_id")
  attemptNumber           Int      @map("attempt_number")
  paymentStatus           String   @map("payment_status")
  humanInterviewAttemptId String? @map("human_interview_attempt_id")
  humanInterviewSessionId String? @map("human_interview_session_id")
  createdAt               DateTime @default(now())

  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  slot      InterviewerSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  attempt HumanInterviewAttempt? @relation(fields: [humanInterviewAttemptId], references: [id], onDelete: SetNull)
  session HumanInterviewSession? @relation(fields: [humanInterviewSessionId], references: [id], onDelete: SetNull)

  @@map("human_interview_bookings")
  @@index([candidateId, createdAt])
}

model ProctoringEvent {
  id             String   @id @default(uuid())
  sessionId      String
  userId         String?
  testType       String?
  type           String   // PHONE_DETECTED, LOOKING_AWAY, MULTIPLE_PERSONS, FACE_MISSING, etc.
  severity       String?
  /// Per-signal violation index for this session when logged (1-based); not a weighted risk score.
  riskScore      Int      @default(0)
  message        String?
  details        Json?
  screenshotPath String?
  confidence     Float?
  createdAt      DateTime @default(now())
}

/// Per-session rolling counts per signal (warn/stop thresholds).
model ProctoringEventCount {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String
  testType       String
  eventType      String
  count          Int      @default(0)
  lastOccurredAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sessionId, eventType])
  @@index([sessionId])
  @@index([userId])
}

/// Cross-role settings: notifications, email alerts, etc.
model UserPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique
  emailNotifications    Boolean  @default(true)
  applicationAlerts     Boolean  @default(true)  // Recruiter: new applications
  weeklyReports         Boolean  @default(false)  // Recruiter: hiring reports
  interviewReminders    Boolean  @default(true)  // Interviewer: slot reminders
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TestCredential {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  role     UserRole
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BlockedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  blockedAt DateTime @default(now())
}

model EmailVerificationCode {
  id                    String   @id @default(uuid())
  email                 String
  codeHash              String
  verificationTokenHash String?
  expiresAt             DateTime
  attempts              Int      @default(0)
  verifiedAt            DateTime?
  consumedAt            DateTime?
  createdAt             DateTime @default(now())

  @@index([email, createdAt])
}

/// Platform-wide feature flags (e.g. proctoring controls). Admin-configurable, no redeploy needed.
model PlatformFeatureFlag {
  id          String   @id @default(uuid())
  featureName String   @unique
  mode        String   @default("OFF") // OFF | MONITOR | STRICT
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}
