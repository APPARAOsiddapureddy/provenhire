generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  jobseeker
  recruiter
  admin
  expert_interviewer
}

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  passwordHash  String // Placeholder hash for OAuth users (never used for login)
  role          UserRole @default(jobseeker)
  emailVerified Boolean  @default(false)
  authProvider  String?  @default("EMAIL") // EMAIL | GOOGLE
  googleUid     String?  @unique
  profileImage  String?
  createdAt     DateTime @default(now())

  jobSeekerProfile               JobSeekerProfile?
  recruiterProfile               RecruiterProfile?
  interviews                     Interview[]
  resumeAnalyses                 ResumeAnalysis[]
  jobApplications                JobApplication[]              @relation("JobApplicationsByUser")
  savedJobs                      SavedJob[]
  verificationStages             VerificationStage[]
  aptitudeResults                AptitudeTestResult[]
  aptitudeSessions               AptitudeSession[]
  dsaResults                     DsaRoundResult[]
  dsaRoundSessions               DsaRoundSession[]
  dsaCodeSessions                DsaCodeSession[]
  dsaFollowUpSessions            DsaFollowUpSession[]
  dataRoundResults               DataRoundResult[]
  notifications                  Notification[]
  appeals                        Appeal[]
  humanInterviewSessions         HumanInterviewSession[]
  humanInterviewAttempts         HumanInterviewAttempt[]
  humanInterviewBookings         HumanInterviewBooking[]
  adminReviewQueuesCandidate     AdminReviewQueue[]            @relation("AdminReviewCandidate")
  adminReviewQueuesReviewer      AdminReviewQueue[]            @relation("AdminReviewReviewer")
  bookedSlots                    InterviewerSlot[]
  refreshTokens                  RefreshToken[]
  passwordResetTokens            PasswordResetToken[]
  interviewerProfile             Interviewer?
  skillVerifications             CandidateSkillVerification[]
  preferences                    UserPreferences?
  provenHireResume               ProvenHireResume?
  resumeChangeRequests           ResumeChangeRequest[]
  retakeCredits                  CandidateRetakeLedger[]
  nonTechAssignments             NonTechAssignment[]
  assessmentRuns                 CandidateAssessmentRun[]
  assessmentEvents               CandidateAssessmentEvent[]
  performanceSignals             CandidatePerformanceSignal[]
  performanceSnapshot            CandidatePerformanceSnapshot?
  antigravityHandoffs            AntigravityHandoff[]
  antigravityReports             AntigravityReport[]
  antigravityTelemetryEvents     AntigravityTelemetryEvent[]
  ownedWorkspaces                Workspace[]
  workspaceRegistrations         WorkspaceRegistration[]       @relation("WorkspaceRegistrationUser")
  removedWorkspaceRegistrations  WorkspaceRegistration[]       @relation("WorkspaceRegistrationRemovedBy")
  restoredWorkspaceRegistrations WorkspaceRegistration[]       @relation("WorkspaceRegistrationRestoredBy")
  mcqSessions                    McqSession[]
  workspaceSqlSessions           WorkspaceSqlSession[]
  workspaceSqlSubmissions        WorkspaceSqlSubmission[]
  workspaceRoundAttempts         WorkspaceRoundAttempt[]
}

/// Issued when a non-technical candidate locks a topic and prompt (written assessment); 48h window from issuedAt.
model NonTechAssignment {
  id               String    @id @default(uuid())
  userId           String
  subtrack         String
  hobbyCategory    String?
  experienceTier   String
  prompt           String    @db.Text
  issuedAt         DateTime  @default(now())
  deadline         DateTime
  status           String    @default("active")
  attemptIndex     Int       @default(0)
  submittedAt      DateTime?
  submittedFileUrl String?
  submittedText    String?   @db.Text
  score            Int?
  passed           Boolean?
  feedbackSummary  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model JobSeekerProfile {
  id                                 String    @id @default(uuid())
  userId                             String    @unique
  fullName                           String?
  email                              String?
  currentRole                        String?
  experienceYears                    Int?
  resumeUrl                          String?
  about                              String?
  phone                              String?
  location                           String?
  college                            String?
  graduationYear                     String?
  verificationStatus                 String?
  skills                             Json?
  education                          Json?
  workExperience                     Json?
  roleType                           String?   @default("technical")
  /// product | design | business | operations | marketing | people — persisted at profile_setup completion (non-tech track).
  nonTechSubtrack                    String?
  /// engineering | science | analysis — persisted at profile_setup completion (data track).
  dataSubtrack                       String?
  targetJobTitle                     String?
  noticePeriod                       String? // e.g. "15 days", "1 month", "Immediate"
  currentSalary                      String? // e.g. "10 LPA", "15-20 L"
  expectedSalary                     String? // e.g. "20 LPA", "25-30 L"
  // Settings: Career preferences & portfolio
  githubUrl                          String?
  linkedInUrl                        String?
  portfolioUrl                       String?
  preferredTechStack                 Json? // string[]
  experienceLevel                    String? // Entry Level | Mid Level | Senior Level
  preferredLocations                 Json? // string[]
  workModePreference                 String? // Remote | Hybrid | Onsite
  /// Set when the user fails 3 consecutive aptitude attempts; cleared implicitly once date passes (checked at request time).
  aptitudeLockedUntil                DateTime?
  /// Latest non-technical verification assignment (prompt + submission); used by GET /assignment/current.
  nonTechAssignmentPrompt            String?   @db.Text
  nonTechAssignmentResponse          String?   @db.Text
  /// Window for assignment freshness (e.g. set to submittedAt + 36h on each submit).
  nonTechAssignmentExpiresAt         DateTime?
  /// Each official graded submit increments this (used for free vs paid retake gating).
  nonTechAssignmentSubmitCount       Int       @default(0)
  nonTechAssignmentLastSubmittedAt   DateTime?
  /// After a paid retake (3rd+ submit), next paid attempt allowed only after this instant (PRD: 7 days).
  nonTechAssignmentPaidCooldownUntil DateTime?
  /// After a failed Human Expert Interview, candidate cannot re-book until this time (PRD: 30 days).
  humanExpertRetryAfter              DateTime?
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum RecruiterVerificationStatus {
  pending
  verified
  rejected
}

enum WorkspaceOwnerRole {
  admin
  recruiter
}

enum WorkspaceStatus {
  draft
  published
  started
  ended
  archived
}

enum WorkspaceAccessMode {
  public
  invite_only
}

enum WorkspaceQuestionType {
  random
  fixed
}

enum WorkspaceRoundType {
  mcq
  coding
  sql
  interview
}

enum WorkspaceRegistrationStatus {
  registered
  removed
}

enum McqSessionStatus {
  active
  submitted
  auto_submitted
  discarded
}

enum WorkspaceSqlSessionStatus {
  active
  submitted
  auto_submitted
  discarded
}

enum WorkspaceRoundAttemptStatus {
  active
  completed
  auto_completed
  discarded
}

model RecruiterProfile {
  id                         String                      @id @default(uuid())
  userId                     String                      @unique
  companyName                String?
  companySize                String?
  designation                String?
  phone                      String?
  companyWebsite             String?
  industry                   String?
  hiringFor                  String?
  onboardingCompleted        Boolean                     @default(false)
  // Recruiter verification (required for job posting)
  fullName                   String?
  workEmail                  String?
  linkedInProfile            String?
  companyLinkedin            String?
  verificationDocumentUrl    String?
  verificationStatus         RecruiterVerificationStatus @default(pending)
  emailDomainVerified        Boolean                     @default(false)
  verificationRejectedReason String? // Admin message when rejected
  // Settings: Company profile
  companyLogo                String?
  headquarters               String?
  companyDescription         String?
  // Settings: Hiring preferences
  preferredRoles             Json? // string[]
  preferredExperienceMin     Int?
  preferredExperienceMax     Int?
  preferredSkills            Json? // string[]
  minimumCertificationLevel  Int?                        @default(1) // 0-3: Cognitive, Skill Passport, Elite
  cultureAndBenefits         Json? // string[] — culture, benefits (PRD recruiter)
  hiringForRoles             Json? // string[] — multi-select roles
  preferredExperienceLevels  Json? // string[] — e.g. fresher | mid | senior
  verifiedAt                 DateTime?
  rejectedAt                 DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  user                 User                           @relation(fields: [userId], references: [id])
  jobs                 Job[]
  usage                RecruiterUsage?
  planPayments         RecruiterPlanPayment[]
  candidateResumeViews RecruiterCandidateResumeView[]
  ownedWorkspaces      Workspace[]
}

/// Freemium / plan usage (PRD §9). Set `periodEnd` in app when opening or rolling a monthly window.
model RecruiterUsage {
  id                    String    @id @default(uuid())
  recruiterId           String    @unique
  planType              String    @default("free") // free | paid (legacy)
  /// free | starter | growth — controls discovery locks + profile view caps (PRD v2.0)
  subscriptionTier      String    @default("free")
  shortlistCountMonth   Int       @default(0)
  profileViewCountMonth Int       @default(0)
  /// PRD §3 — Express Interest sends per calendar month.
  contactCountMonth     Int       @default(0)
  /// PRD §3 — JD AI interviews approved+started per month (when wired).
  jdInterviewCountMonth Int       @default(0)
  activeJobCount        Int       @default(0)
  periodStart           DateTime  @default(now())
  periodEnd             DateTime?
  updatedAt             DateTime  @updatedAt

  recruiter RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
}

model RecruiterPlanPayment {
  id                String    @id @default(uuid())
  recruiterId       String
  tier              String
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("created")
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?
  failureReason     String?   @db.Text
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  recruiter RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId, createdAt])
  @@index([status])
}

model RazorpayWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventName   String
  processedAt DateTime @default(now())
  paymentId   String?
  orderId     String?
  status      String   @default("processed")

  @@index([processedAt])
}

/// Paid retake credits (₹399 single / ₹649 bundle). Admin grants until Razorpay (PRD §7).
model CandidateRetakeLedger {
  id          String    @id @default(uuid())
  userId      String
  packageType String // single | bundle (audit)
  expiresAt   DateTime
  consumedAt  DateTime?
  consumedFor String? // e.g. expert_interview
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, consumedAt])
}

/// First full ProvenHire Resume view per recruiter–candidate pair consumes a profile view credit (PRD §5 / §9).
model RecruiterCandidateResumeView {
  id              String   @id @default(uuid())
  recruiterId     String
  candidateUserId String
  createdAt       DateTime @default(now())

  recruiter RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, candidateUserId])
  @@index([recruiterId])
}

model Workspace {
  id                 String              @id @default(uuid())
  ownerRole          WorkspaceOwnerRole
  ownerUserId        String
  recruiterProfileId String?
  name               String
  organization       String
  code               String              @unique
  startAt            DateTime
  endAt              DateTime
  status             WorkspaceStatus     @default(draft)
  accessMode         WorkspaceAccessMode @default(public)
  totalRounds        Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  ownerUser        User                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  recruiterProfile RecruiterProfile?       @relation(fields: [recruiterProfileId], references: [id], onDelete: Cascade)
  rounds           WorkspaceRound[]
  registrations    WorkspaceRegistration[]
  allowedEmails    WorkspaceAllowedEmail[]
  roundAttempts    WorkspaceRoundAttempt[]

  @@index([ownerRole, ownerUserId])
  @@index([recruiterProfileId])
  @@index([status, startAt, endAt])
  @@index([createdAt])
}

model WorkspaceRound {
  id             String                @id @default(uuid())
  workspaceId    String
  order          Int
  name           String
  type           WorkspaceRoundType
  questionCount  Int
  timeLimitMins  Int
  scoreWeightage Int
  easyCount      Int                   @default(0)
  mediumCount    Int                   @default(0)
  hardCount      Int                   @default(0)
  questionType   WorkspaceQuestionType @default(random)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fixedQuestionSet WorkspaceRoundQuestionSet?
  attempts         WorkspaceRoundAttempt[]

  @@unique([workspaceId, order])
  @@index([workspaceId])
  @@index([workspaceId, type])
}

model WorkspaceRegistration {
  id               String                      @id @default(uuid())
  workspaceId      String
  userId           String
  status           WorkspaceRegistrationStatus @default(registered)
  registeredAt     DateTime                    @default(now())
  removedAt        DateTime?
  removedByUserId  String?
  restoredAt       DateTime?
  restoredByUserId String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User                    @relation("WorkspaceRegistrationUser", fields: [userId], references: [id], onDelete: Cascade)
  removedBy     User?                   @relation("WorkspaceRegistrationRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)
  restoredBy    User?                   @relation("WorkspaceRegistrationRestoredBy", fields: [restoredByUserId], references: [id], onDelete: SetNull)
  roundAttempts WorkspaceRoundAttempt[]

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model WorkspaceAllowedEmail {
  id          String   @id @default(uuid())
  workspaceId String
  email       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email])
}

model WorkspaceRoundQuestionSet {
  id               String   @id @default(uuid())
  workspaceRoundId String   @unique
  questionIds      String[]
  questions        Json
  answerKey        Json
  createdAt        DateTime @default(now())

  workspaceRound WorkspaceRound @relation(fields: [workspaceRoundId], references: [id], onDelete: Cascade)
}

model McqSession {
  id                String           @id @default(uuid())
  userId            String
  questionIds       String[]
  questions         Json             @default(dbgenerated("'[]'::jsonb"))
  answerKey         Json
  currentQuestionId String?
  answers           Json             @default(dbgenerated("'{}'::jsonb"))
  startTime         DateTime         @default(now())
  endTime           DateTime
  status            McqSessionStatus @default(active)
  submittedAt       DateTime?
  finalizedAt       DateTime?
  score             Int?
  correctCount      Int?
  incorrectCount    Int?
  skippedCount      Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceRoundAttempt WorkspaceRoundAttempt?

  @@index([userId, status])
  @@index([endTime, status])
}

model WorkspaceSqlSession {
  id            String                    @id @default(uuid())
  userId        String
  taskIds       String[]
  tasks         Json                      @default(dbgenerated("'[]'::jsonb"))
  currentTaskId String?
  drafts        Json                      @default(dbgenerated("'{}'::jsonb"))
  startTime     DateTime                  @default(now())
  endTime       DateTime
  status        WorkspaceSqlSessionStatus @default(active)
  submittedAt   DateTime?
  finalizedAt   DateTime?
  score         Int?
  passedCount   Int?
  totalCount    Int?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions           WorkspaceSqlSubmission[]
  workspaceRoundAttempt WorkspaceRoundAttempt?

  @@index([userId, status])
  @@index([endTime, status])
}

model WorkspaceSqlSubmission {
  id          String   @id @default(uuid())
  sessionId   String
  userId      String
  taskId      String
  query       String   @db.Text
  passedCount Int
  totalCount  Int
  score       Int
  isOfficial  Boolean  @default(false)
  results     Json
  submittedAt DateTime @default(now())

  session WorkspaceSqlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, taskId, isOfficial])
  @@index([userId, isOfficial])
}

model WorkspaceRoundAttempt {
  id                      String                      @id @default(uuid())
  workspaceId             String
  workspaceRoundId        String
  workspaceRegistrationId String
  userId                  String
  roundType               WorkspaceRoundType
  mcqSessionId            String?                     @unique
  dsaRoundSessionId       String?                     @unique
  sqlSessionId            String?                     @unique
  status                  WorkspaceRoundAttemptStatus @default(active)
  score                   Int?
  percentageScore         Int?
  weightedScore           Int?
  startedAt               DateTime                    @default(now())
  completedAt             DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceRound        WorkspaceRound        @relation(fields: [workspaceRoundId], references: [id], onDelete: Cascade)
  workspaceRegistration WorkspaceRegistration @relation(fields: [workspaceRegistrationId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcqSession            McqSession?           @relation(fields: [mcqSessionId], references: [id], onDelete: SetNull)
  dsaRoundSession       DsaRoundSession?      @relation(fields: [dsaRoundSessionId], references: [id], onDelete: SetNull)
  sqlSession            WorkspaceSqlSession?  @relation(fields: [sqlSessionId], references: [id], onDelete: SetNull)

  @@unique([workspaceRegistrationId, workspaceRoundId])
  @@index([workspaceId, status])
  @@index([workspaceRoundId, status])
  @@index([userId, status])
}

model Job {
  id                        String   @id @default(uuid())
  title                     String
  company                   String
  location                  String?
  // "draft" | "published"
  // Legacy values: "active" treated as "published"; "closed" treated as "draft".
  status                    String   @default("published")
  salaryRange               String?
  jobType                   String?
  description               String?
  jobTrack                  String?  @default("tech")
  assignment                String? // Non-technical: AI-generated assignment for applicants
  roleCategory              String? // e.g. Marketing, Sales, HR
  companyContext            String? // Brief company description for assignment context
  minimumCertificationLevel Int      @default(1)
  /// Required skills for matching + JD interview (PRD v2.0): string[], min 2 max 10 when published
  requiredSkills            Json?
  /// fresher | mid | senior (PRD recruiter discovery)
  experienceRequired        String?
  createdAt                 DateTime @default(now())
  postedById                String?

  postedBy     RecruiterProfile? @relation(fields: [postedById], references: [id])
  applications JobApplication[]
  savedBy      SavedJob[]
}

model JobApplication {
  id                                String    @id @default(uuid())
  jobId                             String
  jobSeekerId                       String
  status                            String    @default("applied")
  appliedAt                         DateTime  @default(now())
  resumeUrl                         String?
  assignmentResponse                String? // Applicant's submission for non-technical job assignment
  recruiterNote                     String?   @db.Text
  stageChangedAt                    DateTime?
  stageHistory                      Json? // [{ stage, changedAt, changedBy? }]
  /// After AI expert completes: recruiter sets next step — provenhire_ai | human_expert | company_employee
  recruiterNextInterviewMode        String?
  recruiterInterviewPathSetAt       DateTime?
  recruiterInterviewPathSetByUserId String?

  job       Job  @relation(fields: [jobId], references: [id])
  jobSeeker User @relation("JobApplicationsByUser", fields: [jobSeekerId], references: [id])
}

model SavedJob {
  id      String   @id @default(uuid())
  jobId   String
  userId  String
  savedAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, jobId])
}

model VerificationStage {
  id        String   @id @default(uuid())
  userId    String
  stageName String
  status    String
  score     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, stageName])
  @@index([stageName, status])
  @@index([userId, status])
}

enum SkillVerificationStatus {
  ACTIVE
  EXPIRED
  PENDING
  FAILED
}

enum SkillType {
  APTITUDE
  LIVE_CODING
  INTERVIEW
}

/// Skill validity and expiry - each verification has completed_at + expires_at.
/// Used for "Skill Freshness Verification System" - candidates must re-attempt after expiry.
model CandidateSkillVerification {
  id              String                  @id @default(uuid())
  userId          String
  skillType       SkillType
  status          SkillVerificationStatus
  score           Int?
  /// 0–100 model confidence for verified skills (AI Skills Interview).
  confidenceScore Float?
  /// Stage that produced verification, e.g. ai_skills_interview.
  verifiedInStage String?
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillType])
  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

model AptitudeTestResult {
  id          String   @id @default(uuid())
  userId      String
  score       Int?
  answers     Json?
  completedAt DateTime @default(now())
  invalidated Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
}

/// Stores answer key + marks key for scoring aptitude submissions. Persisted so retries work across server restarts/instances.
model AptitudeSession {
  id            String    @id @default(uuid())
  userId        String    @unique
  questions     Json      @default(dbgenerated("'[]'::jsonb")) // AptitudeQuestionForClient[] (persisted to allow resume with same question set)
  answerKey     Json // Record<string, string>
  marksKey      Json // Record<string, number>
  draft         Json? // { answers?: Record<string,string>, reviewed?: string[], visited?: string[], currentIndex?: number, secondsRemaining?: number }
  /// Server time when this question set was issued (enforced on submit).
  testStartedAt DateTime?
  /// aptitude_mixed | cs_fundamentals_medium | cs_fundamentals_advanced
  questionSet   String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DsaRoundResult {
  id             String   @id @default(uuid())
  userId         String
  roundSessionId String?  @unique
  score          Int?
  answers        Json?
  completedAt    DateTime @default(now())
  invalidated    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, completedAt])
}

model DsaQuestion {
  id          String   @id @default(cuid())
  title       String
  description String
  difficulty  String
  examples    Json
  constraints String[]
  starterCode Json // { javascript: string, python: string, ... }
  createdAt   DateTime @default(now())

  testCases         DsaTestCase[]
  followUpQuestions DsaFollowUpQuestion[]
  codeSessions      DsaCodeSession[]
  followUpSessions  DsaFollowUpSession[]
}

model DsaRoundSession {
  id               String    @id @default(uuid())
  userId           String
  questionIds      String[]
  startTime        DateTime  @default(now())
  expTime          DateTime
  pausedTime       DateTime?
  activeQId        String?
  activeFollowUpId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeSessions           DsaCodeSession[]
  followUpSessions       DsaFollowUpSession[]
  workspaceRoundAttempts WorkspaceRoundAttempt[]

  @@index([userId])
  @@index([expTime])
}

model DsaCodeSession {
  id             String   @id @default(uuid())
  roundSessionId String
  userId         String
  questionId     String
  language       String
  code           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundSession DsaRoundSession @relation(fields: [roundSessionId], references: [id], onDelete: Cascade)
  question     DsaQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([roundSessionId, questionId, language])
  @@index([userId])
  @@index([roundSessionId, questionId])
}

model DsaFollowUpSession {
  id             String    @id @default(uuid())
  roundSessionId String
  userId         String
  questionId     String
  answers        Json?
  startTime      DateTime  @default(now())
  expTime        DateTime
  pausedTime     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundSession DsaRoundSession @relation(fields: [roundSessionId], references: [id], onDelete: Cascade)
  question     DsaQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([roundSessionId, questionId])
  @@index([userId])
  @@index([expTime])
}

model DsaTestCase {
  id           String  @id @default(cuid())
  questionId   String
  input        String
  expected     String
  isHidden     Boolean @default(false)
  expectedType String  @default("exact") // "exact" | "numeric" | "array" | "set"
  timeoutMs    Int? // Per-test timeout override in ms; null => use global default

  question DsaQuestion @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

model DsaFollowUpQuestion {
  id                 String   @id @default(cuid())
  questionId         String
  followUpQuestionId String
  questionText       String   @db.Text
  options            Json
  correctOptionText  String   @db.Text
  explanation        String?  @db.Text
  createdAt          DateTime @default(now())

  question DsaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, followUpQuestionId])
  @@index([questionId, followUpQuestionId])
}

model DsaSubmission {
  id              String   @id @default(cuid())
  userId          String
  roundSessionId  String?
  questionId      String
  language        String
  code            String   @db.Text
  passedCount     Int
  totalCount      Int
  isOfficial      Boolean  @default(false)
  results         Json
  followUpScore   Int?
  followUpResults Json?
  submittedAt     DateTime @default(now())

  @@index([userId, questionId])
  @@index([userId, isOfficial])
  @@index([roundSessionId])
}

// ---------------------------------------------------------------------------
// Data Round — SQL + Python tasks (data track equivalent of DSA round)
// ---------------------------------------------------------------------------

model DataRoundTask {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  taskType    String // "sql" | "python" | "modeling" | "statistics"
  difficulty  String // "Easy" | "Medium" | "Hard"
  subtrack    String? // "engineering" | "science" | "analysis" | null (any)
  /// For SQL tasks: the CREATE TABLE / INSERT statements that set up the DB
  sqlSchema   String?  @db.Text
  /// Starter code / template shown to the candidate
  starterCode Json? // { python: string } or { sql: string }
  /// For MCQ-style stats tasks: options array
  options     Json? // string[] | null
  createdAt   DateTime @default(now())

  testCases DataRoundTestCase[]
}

model DataRoundTestCase {
  id           String  @id @default(cuid())
  taskId       String
  input        String  @db.Text
  expected     String  @db.Text
  isHidden     Boolean @default(false)
  expectedType String  @default("exact") // "exact" | "csv_match" | "numeric" | "set"
  timeoutMs    Int?

  task DataRoundTask @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model DataRoundSubmission {
  id          String   @id @default(cuid())
  userId      String
  taskId      String
  language    String // "python" | "sql"
  code        String   @db.Text
  passedCount Int
  totalCount  Int
  isOfficial  Boolean  @default(false)
  results     Json
  submittedAt DateTime @default(now())

  @@index([userId, taskId])
  @@index([userId, isOfficial])
}

model DataRoundResult {
  id          String   @id @default(uuid())
  userId      String
  score       Int?
  answers     Json?
  completedAt DateTime @default(now())
  invalidated Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, completedAt])
}

model Interview {
  id                      String    @id @default(uuid())
  userId                  String
  jobRole                 String
  /// ai_skills | system_design | ai_expert | jd_interview
  interviewType           String    @default("ai_expert")
  /// True once DSA submissions were loaded as context (AI Skills Interview).
  dsaContextLoaded        Boolean   @default(false)
  /// System design session only — low-level design score (0–100).
  lldScore                Float?
  /// System design session only — high-level design score (0–100).
  hldScore                Float?
  /// junior | mid | senior — AI interview calibration + DB question selection
  experienceLevel         String?
  totalScore              Int?
  badgeLevel              String?
  finalVerdict            String?
  scoreBreakdown          Json?
  /// in_progress | completed | pending_review
  status                  String    @default("in_progress")
  questionIndex           Int       @default(0)
  questionPlan            Json?
  createdAt               DateTime  @default(now())
  completedAt             DateTime?
  reviewFlag              Boolean   @default(false)
  reviewReason            String?
  /// Count of proctoring alert rows for this interview session (not a 0–100 risk score).
  riskScore               Float?
  /// Total proctoring alert rows (denormalized; optional).
  proctoringEventCount    Int?
  integrityFlag           String?
  /// Unique weakness types covered / question turns — for evaluation calibration
  coverageRatio           Float?
  /// none | low | medium | high — resume claim substantiation (split from engineering signal)
  claimCredibilityRisk    String?
  /// strong | moderate | inconclusive | weak — overall engineering ability independent of claim disputes
  engineeringSignal       String?
  reviewRequestedAt       DateTime?
  reviewRequestReason     String?   @db.VarChar(500)
  reviewOutcome           String?
  reviewOutcomeNote       String?
  /// Multi-pass Gemini evaluation: how many of 3 passes returned valid JSON (1–3)
  evaluationPassCount     Int?
  /// Raw 0–100 scores from each pass, e.g. [72, 78, 74]
  evaluationScoreVariance Json?

  user               User                      @relation(fields: [userId], references: [id])
  messages           InterviewMessage[]
  questionResults    InterviewQuestionResult[]
  proctoringReviews  ProctoringReviewLog[]
  adminReviewQueue   AdminReviewQueue?
  antigravityHandoff AntigravityHandoff?
  antigravityReport  AntigravityReport?

  @@index([userId, interviewType, status])
  @@index([userId, interviewType, status, completedAt])
}

model AntigravityHandoff {
  id                   String    @id @default(uuid())
  userId               String
  interviewId          String    @unique
  antigravitySessionId String?
  launchTokenHash      String    @unique
  status               String    @default("created")
  returnUrl            String?
  launchPayload        Json
  lastError            String?   @db.Text
  expiresAt            DateTime
  launchedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([antigravitySessionId])
  @@index([expiresAt])
}

/// Immutable-source assessment artifact received from the standalone Antigravity service.
/// The normalized report remains queryable even after Antigravity Redis expires.
model AntigravityReport {
  id                   String   @id @default(uuid())
  userId               String
  interviewId          String   @unique
  handoffId            String?
  antigravitySessionId String   @unique
  schemaVersion        String
  status               String   @default("complete")
  overallScore         Float?
  hireRecommendation   String?
  confidenceScore      Float?
  reportHash           String
  report               Json
  evidencePacket       Json?
  telemetrySummary     Json?
  transcript           Json?
  receivedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview       Interview                   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  telemetryEvents AntigravityTelemetryEvent[]

  @@index([userId, receivedAt])
  @@index([handoffId])
  @@index([status])
}

/// Idempotent, append-only runtime facts forwarded by Antigravity.
model AntigravityTelemetryEvent {
  id                   String   @id
  reportId             String
  userId               String
  antigravitySessionId String
  eventName            String
  source               String?
  level                String?
  eventAt              DateTime
  payload              Json
  createdAt            DateTime @default(now())

  report AntigravityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([antigravitySessionId, eventAt])
  @@index([userId, eventAt])
  @@index([eventName])
}

/// Durable, versioned LLM synthesis over persisted assessment evidence.
/// Raw assessment artifacts remain canonical; this is a regenerable reasoning projection.
model AssessmentReportGeneration {
  id               String   @id @default(uuid())
  workspaceId      String
  userId           String
  reportKind       String
  sourceHash       String
  promptVersion    String
  model            String
  status           String   @default("pending")
  result           Json?
  usage            Json?
  estimatedCostUsd Float?
  error             String?  @db.Text
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workspaceId, userId, reportKind, sourceHash, promptVersion, model])
  @@index([workspaceId, userId, reportKind, createdAt])
  @@index([status, createdAt])
}

/// After AI interview submission: admin approves/rejects before human expert stage + payment gate.
model AdminReviewQueue {
  id            String    @id @default(uuid())
  candidateId   String
  aiInterviewId String    @unique
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?
  reviewerId    String?

  candidate   User                    @relation("AdminReviewCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  aiInterview Interview               @relation(fields: [aiInterviewId], references: [id], onDelete: Cascade)
  reviewer    User?                   @relation("AdminReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  attempts    HumanInterviewAttempt[]

  @@index([candidateId])
  @@index([status, createdAt])
}

/// One row per admin approval cycle: tracks payment (₹399 retries) and links to booking.
model HumanInterviewAttempt {
  id                 String   @id @default(uuid())
  candidateId        String
  adminReviewQueueId String
  attemptNumber      Int
  paymentStatus      String   @default("pending")
  slotId             String?
  amountPaise        Int?
  razorpayOrderId    String?  @unique
  razorpayPaymentId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candidate User                    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  queue     AdminReviewQueue        @relation(fields: [adminReviewQueueId], references: [id], onDelete: Cascade)
  slot      InterviewerSlot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)
  session   HumanInterviewSession?
  bookings  HumanInterviewBooking[]

  @@index([candidateId])
  @@index([adminReviewQueueId])
}

model InterviewMessage {
  id                      String   @id @default(uuid())
  interviewId             String
  sender                  String
  message                 String
  questionType            String?
  isFollowup              Boolean  @default(false)
  audioUrl                String? // Stored audio for user answers (no video storage)
  createdAt               DateTime @default(now())
  /// 0-based index of the question this user message answers (Pro Upgrade)
  questionIndex           Int?
  transcriptionConfidence Float?
  inputMode               String   @default("typed") // voice | typed
  rawTranscript           String?  @db.Text
  answerLengthChars       Int?
  pasteCount              Int      @default(0)
  timeToSubmitSeconds     Int?
  flagAntiGaming          Boolean  @default(false)
  flagReason              String?

  interview      Interview                @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionResult InterviewQuestionResult?
}

/// Admin-managed AI interview questions (optional; static fallback when QUESTION_BANK_SOURCE=static)
model InterviewQuestionBank {
  id              String   @id @default(uuid())
  role            String
  experienceLevel String // junior | mid | senior
  type            String // conceptual | scenario | problem_solving | behavioral
  prompt          String   @db.Text
  keyPoints       Json // string[]
  difficulty      Int      @default(2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  tags            String[] @default([])
  /// string[] — 2–3 deepening follow-ups for this prompt (static/DB)
  followups       Json     @default("[]")

  results InterviewQuestionResult[]

  @@index([role, experienceLevel, type, isActive])
}

model InterviewQuestionResult {
  id                 String   @id @default(uuid())
  interviewId        String
  messageId          String   @unique
  questionBankId     String?
  questionIndex      Int
  questionType       String
  scoreConceptual    Float?
  scoreReasoning     Float?
  scoreCommunication Float?
  rationale          String?  @db.Text
  keyPointsHit       String[] @default([])
  keyPointsMissed    String[] @default([])
  flagAntiGaming     Boolean  @default(false)
  flagReason         String?

  interview    Interview              @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  message      InterviewMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  questionBank InterviewQuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
}

model ProctoringReviewLog {
  id          String   @id @default(uuid())
  interviewId String
  adminId     String?
  action      String
  note        String   @db.Text
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model ResumeAnalysis {
  id        String   @id @default(uuid())
  userId    String
  score     Int?
  feedback  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  read       Boolean  @default(false)
  targetRole String? // jobseeker | recruiter | expert_interviewer | all (for broadcast tracking)
  sentBy     String? // admin userId who sent
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model TransactionalEmailLog {
  id        String   @id @default(uuid())
  eventKey  String   @unique
  eventType String
  recipient String
  subject   String
  status    String   @default("sent")
  sentAt    DateTime @default(now())
  metadata  Json?

  @@index([eventType, sentAt])
  @@index([recipient])
}

model JobAlertSubscription {
  id                 String   @id @default(uuid())
  userId             String   @unique
  email              String
  skills             Json?
  isActive           Boolean  @default(true)
  frequency          String   @default("daily")
  minMatchPercentage Int      @default(50)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Appeal {
  id        String   @id @default(uuid())
  userId    String
  stage     String
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model InterviewerApplication {
  id              String    @id @default(uuid())
  name            String
  email           String
  experienceYears Int?
  track           String    @default("technical")
  domains         Json?
  linkedIn        String?
  whyJoin         String?
  phone           String?
  currentCompany  String?
  jobTitle        String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
}

model Interviewer {
  id                       String   @id @default(uuid())
  userId                   String?  @unique
  name                     String?
  domain                   String?
  track                    String?  @default("technical")
  domains                  Json?
  experienceYears          Int?
  phone                    String?
  status                   String   @default("active")
  // Settings: Interviewer profile
  profileImage             String?
  currentCompany           String?
  jobTitle                 String?
  linkedInUrl              String?
  // Settings: Expertise & topics
  expertiseAreas           Json? // string[] e.g. Backend, Frontend, System Design
  preferredInterviewTopics Json? // string[] e.g. DSA, System design
  // Settings: Availability (JSON: { Mon: [{ start, end }], ... })
  availabilitySchedule     Json?
  bio                      String?  @db.Text
  languagesSpoken          Json? // string[]
  profileCompleted         Boolean  @default(false)
  totalInterviews          Int      @default(0)
  totalPassed              Int      @default(0)
  /// PRD §6.4 — { daysOfWeek: number[], timeSlots: string[] } (0=Sunday … 6=Saturday)
  recurringSchedule        Json?
  recurringActive          Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user        User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  slots       InterviewerSlot[]
  sessions    HumanInterviewSession[]
  bankDetails InterviewerBankDetails?
  earnings    InterviewerEarning[]
}

model InterviewerBankDetails {
  id            String   @id @default(uuid())
  interviewerId String   @unique
  accountHolder String
  /// AES-256-GCM ciphertext (base64: iv + tag + payload); never returned from GET APIs.
  accountNumber String
  ifscCode      String
  bankName      String
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
}

model InterviewerEarning {
  id            String    @id @default(uuid())
  interviewerId String
  sessionId     String    @unique
  amountPaise   Int
  month         Int
  year          Int
  payoutStatus  String    @default("pending") // pending | paid | failed
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  interviewer Interviewer           @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  session     HumanInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InterviewerInvite {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model InterviewerSlot {
  id            String    @id @default(uuid())
  interviewerId String
  startsAt      DateTime
  endsAt        DateTime?
  status        String    @default("available")
  bookedUserId  String?

  interviewer            Interviewer             @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  bookedUser             User?                   @relation(fields: [bookedUserId], references: [id])
  session                HumanInterviewSession?
  attemptBookings        HumanInterviewAttempt[]
  humanInterviewBookings HumanInterviewBooking[]
}

model HumanInterviewSession {
  id                      String                 @id @default(uuid())
  userId                  String
  interviewerId           String
  slotId                  String?                @unique
  scheduledAt             DateTime?
  completedAt             DateTime?
  status                  String                 @default("scheduled")
  meetingLink             String?
  verificationTier        String?
  evaluationScores        Json?
  evaluationNotes         String?
  interviewerNotes        String?                @db.Text
  candidateFeedback       String?                @db.Text
  evaluationPass          Boolean?
  evaluationSubmittedAt   DateTime?
  attemptNumber           Int                    @default(1)
  paymentStatus           String                 @default("waived")
  humanInterviewAttemptId String?                @unique
  humanInterviewAttempt   HumanInterviewAttempt? @relation(fields: [humanInterviewAttemptId], references: [id], onDelete: SetNull)

  user        User                    @relation(fields: [userId], references: [id])
  interviewer Interviewer             @relation(fields: [interviewerId], references: [id])
  slot        InterviewerSlot?        @relation(fields: [slotId], references: [id])
  bookings    HumanInterviewBooking[]
  earning     InterviewerEarning?
}

/// Canonical slot booking record for the Human Expert Interview.
/// Matches the PRD table `human_interview_bookings`.
model HumanInterviewBooking {
  bookingId               String   @id @default(uuid()) @map("booking_id")
  candidateId             String   @map("candidate_id")
  slotId                  String   @map("slot_id")
  attemptNumber           Int      @map("attempt_number")
  paymentStatus           String   @map("payment_status")
  humanInterviewAttemptId String?  @map("human_interview_attempt_id")
  humanInterviewSessionId String?  @map("human_interview_session_id")
  createdAt               DateTime @default(now())

  candidate User            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  slot      InterviewerSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  attempt HumanInterviewAttempt? @relation(fields: [humanInterviewAttemptId], references: [id], onDelete: SetNull)
  session HumanInterviewSession? @relation(fields: [humanInterviewSessionId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@map("human_interview_bookings")
}

model ProctoringEvent {
  id             String   @id @default(uuid())
  sessionId      String
  userId         String?
  testType       String?
  type           String // PHONE_DETECTED, LOOKING_AWAY, MULTIPLE_PERSONS, FACE_MISSING, etc.
  severity       String?
  /// Per-signal violation index for this session when logged (1-based); not a weighted risk score.
  riskScore      Int      @default(0)
  message        String?
  details        Json?
  screenshotPath String?
  confidence     Float?
  createdAt      DateTime @default(now())
}

/// Per-session rolling counts per signal (warn/stop thresholds).
model ProctoringEventCount {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String
  testType       String
  eventType      String
  count          Int      @default(0)
  lastOccurredAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sessionId, eventType])
  @@index([sessionId])
  @@index([userId])
}

/// Evidence-based ProvenHire Resume (PRD v2). Synced from verification + interviews; not freely editable by candidates.
model ProvenHireResume {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  /// L0 | L1 | L2 | L3 (string for badge display)
  certificationLevel     String    @default("L0")
  certificationDate      DateTime?
  verifiedSkills         Json      @default("[]")
  /// [{ skill, source: 'resume' | ... }]
  claimedSkills          Json      @default("[]")
  projects               Json      @default("[]")
  assessmentScores       Json      @default("{}")
  createdAt              DateTime  @default(now())
  lastUpdatedAt          DateTime  @updatedAt
  isPublic               Boolean   @default(false)
  pendingCandidateReview Boolean   @default(false)
  /// Auto-generated share slug: firstname-last4ofId (unique).
  shareableHandle        String    @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareableHandle])
}

/// Candidate requests edits to restricted resume sections; admin reviews (PRD v2).
model ResumeChangeRequest {
  id        String   @id @default(uuid())
  userId    String
  section   String
  note      String   @db.Text
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Cross-role settings: notifications, email alerts, etc.
model UserPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  applicationAlerts  Boolean  @default(true) // Recruiter: new applications
  weeklyReports      Boolean  @default(false) // Recruiter: hiring reports
  interviewReminders Boolean  @default(true) // Interviewer: slot reminders
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TestCredential {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BlockedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  blockedAt DateTime @default(now())
}

// ─── Unified Candidate Performance Pipeline ────────────────────────────────────

/// One record per completed / failed module attempt.
model CandidateAssessmentRun {
  id          String   @id @default(uuid())
  userId      String
  /// "dsa" | "ai_skills" | "system_design_data" | "system_design_software" | "antigravity"
  module      String
  runIndex    Int
  /// "completed" | "failed" | "invalidated"
  status      String
  score       Float?
  pass        Boolean?
  track       String?
  targetRole  String?
  completedAt DateTime @default(now())
  meta        Json     @default("{}")

  user    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events  CandidateAssessmentEvent[]
  signals CandidatePerformanceSignal[]

  @@index([userId, module])
  @@index([userId, completedAt])
}

/// Individual signals / events captured within a run.
model CandidateAssessmentEvent {
  id         String   @id @default(uuid())
  runId      String
  userId     String
  eventType  String
  competency String?
  value      Float?
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  run  CandidateAssessmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([userId, competency])
}

/// Normalized, cross-run competency fact — one row per run+competency.
/// "LIVE_CODING" | "AI_SKILLS" | "SYSTEM_DESIGN_LLD" | "SYSTEM_DESIGN_HLD" | "EXPERT_INTERVIEW"
model CandidatePerformanceSignal {
  id         String   @id @default(uuid())
  userId     String
  runId      String?
  competency String
  score      Float
  pass       Boolean
  source     String
  capturedAt DateTime @default(now())

  user User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  CandidateAssessmentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, competency])
  @@index([userId, capturedAt])
}

/// Aggregated snapshot — one row per candidate, upserted after every publishRunResult.
model CandidatePerformanceSnapshot {
  id                   String   @id @default(uuid())
  userId               String   @unique
  dsaScore             Float?
  aiSkillsScore        Float?
  systemDesignScore    Float?
  antigravityScore     Float?
  verifiedCompetencies Json     @default("[]")
  contextBlob          Json     @default("{}")
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationCode {
  id                    String    @id @default(uuid())
  email                 String
  codeHash              String
  verificationTokenHash String?
  expiresAt             DateTime
  attempts              Int       @default(0)
  verifiedAt            DateTime?
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([email, createdAt])
}

/// Platform-wide feature flags (e.g. proctoring controls). Admin-configurable, no redeploy needed.
model PlatformFeatureFlag {
  id          String   @id @default(uuid())
  featureName String   @unique
  mode        String   @default("OFF") // OFF | MONITOR | STRICT
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}
