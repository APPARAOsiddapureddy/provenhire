{
  "name": "provenhire-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-build-data.mjs",
    "start": "npm run deploy:migrate && (node -e \"process.exit(process.env.SEED_ON_START==='true'?0:1)\" && npm run seed:dsa && npm run seed:data-round && npm run seed:skill-verifications || true) && node dist/server.js",
    "deploy:migrate": "node scripts/migrate-with-retry.mjs",
    "prisma": "prisma",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "migrate:legacy": "tsx src/utils/migrate.ts",
    "seed:interviewer": "tsx prisma/seed-interviewer.ts",
    "seed:recruiter": "tsx prisma/seed-recruiter.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "seed:ai-interview": "tsx prisma/seed-ai-interview-user.ts",
    "seed:test-credentials": "tsx prisma/seed-test-credentials.ts",
    "seed:feature-flags": "tsx prisma/seed-feature-flags.ts",
    "seed:skill-verifications": "tsx prisma/seed-skill-verifications.ts",
    "seed:dsa": "tsx prisma/seeds/dsaQuestions.seed.ts",
    "seed:data-round": "tsx prisma/seeds/dataRoundTasks.seed.ts",
    "seed:all": "npm run seed:dsa && npm run seed:data-round && npm run seed:skill-verifications",
    "dsa:judge0-smoke": "tsx scripts/dsa-starter-judge0-smoke.ts",
    "audit:create-users": "tsx scripts/createTestUsers.ts",
    "audit:flow": "tsx scripts/auditFlow.ts",
    "test:candidate-synthesis": "tsx scripts/candidate-synthesis-contract.ts",
    "test:report-integrity": "tsx scripts/report-integrity-contract.ts",
    "seed:interview-bank": "tsx prisma/seeds/interviewQuestionBank.seed.ts",
    "clear-test-users": "tsx prisma/clear-test-users.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1025.0",
    "@aws-sdk/lib-storage": "^3.1025.0",
    "@google/genai": "^1.43.0",
    "@prisma/client": "^5.20.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.76.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "openai": "^6.33.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.4.0",
    "pino-http": "^9.0.0",
    "resend": "^6.9.3",
    "socket.io": "^4.8.3",
    "tsx": "^4.19.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^7.0.11",
    "prisma": "^5.20.0",
    "typescript": "^5.8.3"
  }
}
