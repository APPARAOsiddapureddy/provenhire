# Comma-separated extra allowed browser origins (production). Preview apps: set CORS_ALLOW_VERCEL_PREVIEWS=true or list exact URLs here.
# CORS_EXTRA_ORIGINS=https://your-preview.vercel.app
# CORS_ALLOW_VERCEL_PREVIEWS=false

# Must match Vite proxy target (vite.config.ts). Default: 10000 for local dev.
PORT=10000
DATABASE_URL=postgresql://user:password@localhost:5432/provenhire

# --- Render.com PostgreSQL (fixes Prisma P1001) ---
# Use **External Database URL** from: Dashboard → your Postgres → Info → External Database URL.
# Host must be the full name, e.g. dpg-xxxxx-a.REGION.postgres.render.com — not just dpg-xxxxx-a
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a.oregon-postgres.render.com/DBNAME?sslmode=require
# Optional: PRISMA_MIGRATE_MAX_ATTEMPTS=20 PRISMA_MIGRATE_RETRY_MS=5000 (see server/scripts/migrate-with-retry.mjs)
JWT_SECRET=change-me
BASE_URL=http://localhost:5173

# Canonical site URL for ProvenHire Resume share links (server-generated). Default: https://provenhire.in
# PUBLIC_SITE_URL=https://provenhire.in

# Verification pipeline v2 (PRD April 2026): track-based stages + AI Skills + System Design. Default ON.
# Set to false only to revert to legacy aptitude + human expert chain.
# VERIFICATION_PIPELINE_V2=true
# ALLOW_PLACEHOLDER_STAGE_COMPLETION=false

# Gemini — interviews, assignments, legacy resume fallback (aistudio.google.com/apikey)
# GEMINI_API_KEY=your-gemini-key

# OpenAI API key (platform.openai.com — ChatGPT Plus is separate from API billing)
# Used for: resume parsing (preferred when set), Whisper /api/interview/transcribe, etc.
# OPENAI_API_KEY=your_openai_api_key
# Resume JSON extraction model (default gpt-4o-mini). Optional: gpt-4o, gpt-4.1-mini, etc.
# RESUME_PARSER_MODEL=gpt-4o-mini
# Force provider: openai | gemini | auto (default auto = OpenAI first, then Gemini if OpenAI fails or is unset)
# RESUME_PARSER_PROVIDER=auto

# AI interview: run final evaluation synchronously on the HTTP request (default: async background + status "evaluating").
# INTERVIEW_SYNC_EVAL=true

# Cloudflare R2 (S3-compatible). When all are set, uploads use R2; otherwise files go to server/uploads.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_URL=https://your-bucket.your-domain or R2 public URL
# Production: set OPENAI_API_KEY on the API host (e.g. Render → Environment). If transcribe returns 413, raise the reverse proxy body limit (nginx: client_max_body_size 25m; Cloudflare: allow larger uploads to /api).

# Voice AI interview (v2 adversarial flow): optional Deepgram (legacy) + ElevenLabs / Cartesia TTS
# Deepgram: key should allow POST /v1/auth/grant (Member permission or higher in console) so the API can mint short-lived JWTs for the browser.
# DEEPGRAM_API_KEY=your_deepgram_key
# TTS: Cartesia primary, ElevenLabs fallback — see docs/PRD_AI_INTERVIEW.md §12
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=                         # e.g. a0e99841-438c-4a64-b679-ae501e7d6091 — required with CARTESIA_API_KEY for AI interview TTS + filler pre-cache at startup
# ELEVENLABS_API_KEY=your_elevenlabs_key
# Default voice (Kartik, Indian English) and multilingual model — good for India-first product; override as needed.
# ELEVENLABS_VOICE_ID=XPqjYvTqfyUQr09yCpCY
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# AI interview question bank: "static" (in-code, default) or "db" after running: npm run seed:interview-bank
# QUESTION_BANK_SOURCE=static

# MVP: Using Google Meet. Daily.co disabled. Uncomment when budget allows.
# DAILY_API_KEY=your_daily_api_key
# DAILY_DOMAIN=provenhire

# Email - Resend. Add your API key from resend.com
# For delivery to real inboxes: verify domain at resend.com/domains, then set EMAIL_FROM
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=ProvenHire <noreply@yourdomain.com>
#
# Optional fallback - Gmail SMTP when Resend fails:
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Human Expert Interview retry fee (₹399) — Razorpay orders + signature verify
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# Local/dev only: set true to allow POST /api/human-interview/payment/mock-success (never enabled implicitly by NODE_ENV).
# ALLOW_MOCK_HUMAN_INTERVIEW_PAYMENT=true

# Test expert interviewer (run: npm run seed:interviewer)
# qa.expert.apr2026@test.provenhire.com / PhE2E_Apr2026!x7

# Test recruiter (run: npm run seed:recruiter)
# qa.recruiter.apr2026@test.provenhire.com / PhE2E_Apr2026!x7

# Test job seekers for verification flow (run: npm run seed:test-credentials)
# qa.apt.apr2026@test.provenhire.com — aptitude stage / PhE2E_Apr2026!x7
# qa.dsa.apr2026@test.provenhire.com — DSA stage / PhE2E_Apr2026!x7
# qa.ai.apr2026@test.provenhire.com — AI interview stage / PhE2E_Apr2026!x7
# qa.ai2.apr2026@test.provenhire.com — second AI interview account / PhE2E_Apr2026!x7
#
# These logins only work if that seed has been run against the SAME Postgres as your API
# (e.g. local DATABASE_URL). Production will return 401 until you run seeds once on prod
# or use Sign Up to create a real user. Optional staging-only: SEED_ON_START=true runs
# admin + test jobseekers + DSA questions on each deploy start (never on public prod).

# Test admin (run: npm run seed:admin)
# admin@test.provenhire.com / Admin123456

# Verification code: default is to display on signup page (testing/virtual deployment).
# Set to "false" when using real email delivery (Resend/Gmail) in production.
# DISPLAY_VERIFICATION_CODE_ON_PAGE=false

# Google Sign-In (Firebase)
# Option A: Service account JSON file path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
#
# Option B: Env vars (for Render, Vercel, etc.)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI Proctoring (Python FastAPI + OpenCV + YOLO). Default: http://127.0.0.1:8001
# AI_PROCTOR_URL=http://127.0.0.1:8001

# Code execution for DSA round (optional). Defaults to public Judge0 CE.
# For production or higher limits, consider self-hosting Judge0: https://github.com/judge0/judge0
# JUDGE0_CE_URL=https://ce.judge0.com

# Cron - skill expiry job (call daily 00:00 UTC via cron-job.org etc.)
# CRON_SECRET=your-secret-for-cron-endpoints

# BlockedEmail table: off by default so Google SSO / register are not 403 for listed emails.
# Set to true only if you actively maintain BlockedEmail and want enforcement.
# ENFORCE_BLOCKED_EMAILS=true
